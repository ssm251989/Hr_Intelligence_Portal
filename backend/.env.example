DATABASE_URL=postgresql://hr_user:hr_password@localhost:5432/hr_automation
# Control plane (Part 2): a separate database holding tenants/plans/modules -- one row per
# tenant even under TENANCY_MODE=single, where there's exactly one. Never the same DSN as
# DATABASE_URL, even in dev, so control-plane and tenant-data migrations stay independent.
CONTROL_PLANE_DATABASE_URL=postgresql://hr_user:hr_password@localhost:5432/hr_automation_control_plane
# Which SecretStore backend platform/secrets/store.py uses -- db_encrypted (default, needs
# only MASTER_KEY below), vault, aws_secrets_manager, azure_key_vault (interfaces only so
# far, see docs/HRMS_COMPLETE_SPEC.txt Part 2 section 5).
SECRET_BACKEND=db_encrypted
# Wraps every tenant's own generated data-encryption key (envelope encryption) -- NOT used
# to encrypt secrets directly. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_KEY=
ANTHROPIC_API_KEY=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Google Calendar integration (Interview Scheduling).
# Setup:
#   1. In Google Cloud Console, create an OAuth 2.0 Client ID of type "Web application".
#   2. Enable the Google Calendar API for the project.
#   3. Add http://localhost:8000/auth/google/callback as an authorized redirect URI.
#   4. Paste the generated client ID/secret below. Only needed for engineers testing
#      the live consent flow -- the automated test suite mocks this integration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# DocuSign integration (Offer e-signature).
# Setup:
#   1. Create an app in the DocuSign Developer Console (https://developers.docusign.com).
#   2. Choose "Authorization Code Grant" as the app's grant type (no PKCE).
#   3. Add http://localhost:8000/auth/docusign/callback as an authorized redirect URI.
#   4. Paste the generated Integration Key (client ID) and Secret Key below, along with
#      the Account ID shown on the app's dashboard.
#   5. The base URLs below point at the DocuSign demo/sandbox environment. In production,
#      switch to https://account.docusign.com and the account's production API base URI.
#      Only needed for engineers testing the live consent/e-signature flow -- the
#      automated test suite mocks this integration.
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_SECRET_KEY=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_AUTH_BASE_URL=https://account-d.docusign.com
DOCUSIGN_API_BASE_URL=https://demo.docusign.net
DOCUSIGN_REDIRECT_URI=http://localhost:8000/auth/docusign/callback

# LinkedIn integration (hiring-announcement auto-post on job publish).
# Setup:
#   1. Create an app in the LinkedIn Developer Portal (https://www.linkedin.com/developers/apps).
#   2. Under Products, request "Sign In with LinkedIn using OpenID Connect" AND
#      "Share on LinkedIn" (grants the w_member_social scope) -- both are self-serve.
#   3. Add http://localhost:8000/auth/linkedin/callback as an authorized redirect URL
#      under the app's Auth tab.
#   4. Paste the generated Client ID/Secret below.
#   5. IMPORTANT: standard/self-serve LinkedIn apps only get a short-lived access token
#      (~60 days) with NO refresh token -- there is no way to silently renew it. Once it
#      expires, the user must reconnect via Settings; this app surfaces that as a clear
#      "expired, please reconnect" status rather than a raw API error.
#   6. LINKEDIN_API_VERSION follows LinkedIn's YYYYMM version scheme, which they rotate
#      out on a schedule -- bump this if LinkedIn starts rejecting requests as an
#      unsupported version. Only needed for engineers testing the live consent/posting
#      flow -- the automated test suite mocks this integration.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/linkedin/callback
LINKEDIN_API_VERSION=202507

# The frontend's own origin, used server-side to build the job link included in a
# LinkedIn hiring-announcement post (the backend has no other way to know this).
FRONTEND_URL=http://localhost:5173
