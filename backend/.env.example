DATABASE_URL=postgresql://hr_user:hr_password@localhost:5432/hr_automation
ANTHROPIC_API_KEY=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Google Calendar integration (Interview Scheduling).
# Setup:
#   1. In Google Cloud Console, create an OAuth 2.0 Client ID of type "Web application".
#   2. Enable the Google Calendar API for the project.
#   3. Add http://localhost:8000/auth/google/callback as an authorized redirect URI.
#   4. Paste the generated client ID/secret below. Only needed for engineers testing
#      the live consent flow -- the automated test suite mocks this integration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# DocuSign integration (Offer e-signature).
# Setup:
#   1. Create an app in the DocuSign Developer Console (https://developers.docusign.com).
#   2. Choose "Authorization Code Grant" as the app's grant type (no PKCE).
#   3. Add http://localhost:8000/auth/docusign/callback as an authorized redirect URI.
#   4. Paste the generated Integration Key (client ID) and Secret Key below, along with
#      the Account ID shown on the app's dashboard.
#   5. The base URLs below point at the DocuSign demo/sandbox environment. In production,
#      switch to https://account.docusign.com and the account's production API base URI.
#      Only needed for engineers testing the live consent/e-signature flow -- the
#      automated test suite mocks this integration.
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_SECRET_KEY=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_AUTH_BASE_URL=https://account-d.docusign.com
DOCUSIGN_API_BASE_URL=https://demo.docusign.net
DOCUSIGN_REDIRECT_URI=http://localhost:8000/auth/docusign/callback
