# secret you generate yourself -- never reuse one for UAT/prod (those come from AWS Secrets
# Manager via Terraform / the Helm chart's existingSecret).
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
